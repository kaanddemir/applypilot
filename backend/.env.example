# Required for POST /api/analyze-job. Never expose this value in frontend code.
GEMINI_API_KEY=

# Gemini request configuration.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_CONNECT_TIMEOUT_SECONDS=5
# Total wall-clock deadline across both attempts; maximum 90 (browser: 100).
GEMINI_TIMEOUT_SECONDS=90
# Combined thinking + JSON ceiling, not a target. Concise requirements only.
GEMINI_MAX_OUTPUT_TOKENS=16384
GEMINI_THINKING_LEVEL=low

# In-memory protection for the unauthenticated local analysis endpoint.
ANALYSIS_CLIENT_LIMIT_PER_MINUTE=6
ANALYSIS_GLOBAL_LIMIT_PER_MINUTE=20
ANALYSIS_MAX_CONCURRENCY=2
ANALYSIS_MAX_BODY_BYTES=81920

# Optional comma-separated browser origins for a separately served frontend.
# Same-origin FastAPI serving needs no CORS configuration.
APPLYPILOT_CORS_ORIGINS=

# Host header allow-list. Keep local defaults unless you intentionally change
# the binding and understand the unauthenticated paid-endpoint risk.
APPLYPILOT_ALLOWED_HOSTS=localhost,127.0.0.1
